# Apache virtual host for the marketplace: serves /static/ directly and
# reverse-proxies everything else to gunicorn over a unix socket.
# Mirrors the live configuration on danse2 (marketplace.sasview.org).
# The dev site (marketplacedev.sasview.org) is identical with "marketplace"
# replaced by "marketplacedev" throughout.
#
# Needs: a2enmod proxy proxy_http headers rewrite ssl
# TLS certificates are issued and renewed by certbot (Let's Encrypt).

<VirtualHost *:80>
    ServerName marketplace.sasview.org
    DocumentRoot /var/www/marketplace.sasview.org

    RewriteEngine On
    RewriteCond %{SERVER_NAME} =marketplace.sasview.org
    RewriteRule ^ https://%{SERVER_NAME}%{REQUEST_URI} [END,NE,R=permanent]
</VirtualHost>

<IfModule mod_ssl.c>
<VirtualHost *:443>
    ServerName marketplace.sasview.org
    DocumentRoot /var/www/marketplace.sasview.org

    # Static files are collected here by `manage.py collectstatic` (STATIC_ROOT).
    Alias /static/ /var/www/marketplace.sasview.org/sasmarket/static/
    <Directory /var/www/marketplace.sasview.org/sasmarket/static>
        Require all granted
    </Directory>

    # Everything else goes to gunicorn (see marketplace.service.example).
    ProxyPass /static/ !
    ProxyPass / unix:/run/marketplace-gunicorn/marketplace.sock|http://localhost/ retry=0
    ProxyPassReverse / unix:/run/marketplace-gunicorn/marketplace.sock|http://localhost/
    ProxyPreserveHost On
    RequestHeader set X-Forwarded-Proto "https"

    ErrorLog /var/log/apache2/marketplace.error.log
    CustomLog /var/log/apache2/marketplace.access.log combined

    SSLEngine on
    Include /etc/letsencrypt/options-ssl-apache.conf
    SSLCertificateFile /etc/letsencrypt/live/marketplace.sasview.org/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/marketplace.sasview.org/privkey.pem
</VirtualHost>
</IfModule>
